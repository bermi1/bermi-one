<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon.

    The background is a flat colour that fills the whole 108dp canvas. It must
    not be inset: a launcher using a circular mask crops the outer ring, and an
    inset background leaves that ring transparent — a blue mark floating in a
    hole. Only the foreground is inset, to the 72dp safe zone, so nothing of the
    mark is lost whatever shape the launcher cuts.

    The monochrome layer is what Android 13 and later tint to the wallpaper.
    Without it a themed home screen shows the full-colour icon among tinted
    ones, which looks like an app that was never finished.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.7%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@mipmap/ic_launcher_monochrome" android:inset="16.7%" />
    </monochrome>
</adaptive-icon>
